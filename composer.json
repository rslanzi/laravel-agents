{
    "name": "rslanzi/laravel-agents",
    "description": "AI agent guidelines (Laravel Boost) and quality tooling for modular, DDD-style Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "boost",
        "agents",
        "ddd",
        "guidelines"
    ],
    "homepage": "https://github.com/rslanzi/laravel-agents",
    "authors": [
        {
            "name": "Riccardo",
            "homepage": "https://github.com/rslanzi",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/rslanzi/laravel-agents/issues",
        "source": "https://github.com/rslanzi/laravel-agents"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/process": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Rslanzi\\LaravelAgents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rslanzi\\LaravelAgents\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rslanzi\\LaravelAgents\\LaravelAgentsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
